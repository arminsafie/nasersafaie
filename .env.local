# Copy this file to .env.local and fill in real values.
# .env.local is gitignored by default — never commit real secrets.

# Required: the password you'll use to log into /admin.
# Choose something long and unique; this protects write access to your
# entire site's content.
ADMIN_PASSWORD=ns1968

# Optional but recommended: a separate secret used to sign admin session
# cookies. If omitted, ADMIN_PASSWORD is reused for this — setting a
# distinct random value here is safer, since rotating the session secret
# instantly invalidates all logged-in sessions without changing the
# password itself. Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=
